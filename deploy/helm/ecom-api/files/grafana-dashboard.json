          "query": "label_values(dotnet_process_memory_working_set_bytes, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "current": {
          "text": "ecomapi",
          "value": "ecomapi"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
