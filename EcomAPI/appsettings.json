{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BaseConnection": "Data Source=NoCQRS.db",
    "WriteDbConnection": "Data Source=Write.db",
    "ReadDbConnection": "Data Source=Read.db"
  },
  "EventBus": {
    "Provider": "InProcess"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9094",
    "Topic": "orders.order-created",
    "ConsumerGroupId": "ecomapi-read-projection",
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1
  },
  "Outbox": {
    "PollingIntervalMs": 1000,
    "BatchSize": 50
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnection": "localhost:6379",
    "InstanceName": "ecomapi:",
    "OrderTtlSeconds": 300,
    "SummariesTtlSeconds": 30,
    "LocalTtlSeconds": 10
  },
  "Telemetry": {
    "ServiceName": "ecomapi",
    "OtlpEndpoint": "http://localhost:4317",
    "Tracing": {
      "Enabled": false,
      "SamplingRatio": 1.0
    },
    "Metrics": {
      "Enabled": false,
      "ExportIntervalMs": 15000
    },
    "Logs": {
      "Enabled": false
    }
  }
}
